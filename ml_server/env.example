# RabbitMQ Configuration
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=admin
RABBITMQ_PASSWORD=admin
RABBITMQ_VHOST=/

# Redis Configuration
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Job Configuration
JOB_TTL_SECONDS=86400
MAX_CONCURRENT_JOBS=5

# Model Configuration
SPECIFIC_ITEM_MODEL_PATH=/app/specific_model/model/model.joblib
CATEGORY_MODEL_PATH=/app/general_model/model/model.joblib

# Logging Configuration
LOG_LEVEL=INFO

# Health Check Configuration
HEALTH_CHECK_INTERVAL=30
HEALTH_CHECK_TIMEOUT=5

# Queue Configuration
PREDICTION_QUEUE=prediction_queue
PREDICTION_RESULT_QUEUE=prediction_result_queue
QUEUE_DURABLE=True
QUEUE_AUTO_DELETE=False

# OpenAI Configuration
OPENAI_API_KEY=your_openai_api_key_here

# Google Vertex AI Configuration (for Gemini)
GOOGLE_APPLICATION_CREDENTIALS=vertexai_credentials.json
VERTEXAI_PROJECT_ID=mise-ai-476319
